# ---------------------------------------------------------------------------
# Valmieras tehnikuma pieteikumu sistēma — vides mainīgie
# Kopējiet šo failu uz .env.local (lokāli) vai ievadiet Vercel → Settings → Environment Variables.
# NEKAD neievietojiet īstās atslēgas repozitorijā.
# ---------------------------------------------------------------------------

# Supabase projekta URL (Supabase → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Publiskā atslēga: "anon" (legacy JWT) VAI "publishable" atslēga (sb_publishable_...).
# Šī atslēga drīkst būt publiska — datus aizsargā Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SLEPENĀ atslēga: "service_role" (legacy) VAI "secret" atslēga (sb_secret_...).
# Izmanto TIKAI serverī (lietotāju izveide/paroles atiestatīšana). Nekad ar NEXT_PUBLIC_ prefiksu!
SUPABASE_SERVICE_ROLE_KEY=

# Lietotnes publiskā adrese (neobligāti; izmanto absolūtām saitēm)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
